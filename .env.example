# M2 local configuration. Copy to .env and supply values locally.
MYSQL_DATABASE=scholartrace
MYSQL_USER=scholartrace
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
# Optional if the default local ports are already in use.
# SCHOLARTRACE_API_PORT=18000
# SCHOLARTRACE_UI_PORT=18501
# SCHOLARTRACE_MCP_PORT=18001
# SCHOLARTRACE_MILVUS_PORT=19531
# All five application services use the same built image.
SCHOLARTRACE_IMAGE=scholartrace:local
SCHOLARTRACE_DATA_DIR=./data/m2
SCHOLARTRACE_MODEL_CACHE=./data/model-cache
SCHOLARTRACE_MODELS_DIR=./data/models
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_BATCH_SIZE=8
MODEL_CPU_THREADS=4
# Set 1 only after all required model weights have been cached.
HF_HUB_OFFLINE=0
DEEPSEEK_API_KEY=
SERPAPI_API_KEY=
OPENALEX_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=90

# M3 retrieval; select milvus after its server is available and papers are reindexed.
RAG_VECTOR_BACKEND=milvus
RAG_COLLECTION_NAME=paper_chunks_m3
MILVUS_URI=http://127.0.0.1:19530
RAG_RETRIEVAL_MODE=dense
RAG_CANDIDATE_K=20
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_PDF_PARSER_BACKEND=docling

# M4 worker; Compose sets its internal Redis URL automatically.
# When running outside Compose, use a reachable local Redis service.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# M5 bounded LangGraph workflows and optional Langfuse tracing.
SEARCH_GRAPH_MAX_SECONDS=300
RAG_EVIDENCE_MAX_EXPANSIONS=1
# Set all three to send traces to your Langfuse instance.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Conversations: complete recent exchanges only; character budgets are not tokenizer counts.
CHAT_HISTORY_MAX_TURNS=6
CHAT_HISTORY_MAX_CHARS=6000
CHAT_PROMPT_MAX_CHARS=24000
CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_LEASE_SECONDS=900
